# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4
#set $mod Mod1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $refresh_i3status

bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioMute exec --no-startup-id playerctl next

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

set $virtmgr "sh /home/chloe/Documents/QEMU-KVM/openVirtManager.sh"

set $hidemouse "sh -c 'eval `xdotool getdisplaygeometry --shell`; xdotool mousemove $((WIDTH/2)) $((HEIGHT))'"
set $movemouse "sh -c 'eval `xdotool getactivewindow getwindowgeometry --shell`; xdotool mousemove $((X+WIDTH/2)) $((Y+HEIGHT/16))'"
set $delaymovemouse "sh -c 'xdotool sleep 0.5; eval `xdotool getactivewindow getwindowgeometry --shell`; xdotool mousemove $((X+WIDTH/2)) $((Y+HEIGHT/16))'"

# start a terminal
bindsym Mod1+Control+t exec i3-sensible-terminal; exec --no-startup-id $delaymovemouse
bindsym $mod+Return exec i3-sensible-terminal; exec --no-startup-id $delaymovemouse
bindsym $mod+Shift+f split toggle, exec librewolf; exec --no-startup-id $delaymovemouse
bindsym $mod+Shift+c split toggle, exec "kitty"; exec --no-startup-id $delaymovemouse
bindsym $mod+Shift+t split toggle, exec "urxvt"; exec --no-startup-id $delaymovemouse

# kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+q exec --no-startup-id dmenu_run

bindsym $mod+Tab          focus prev; exec --no-startup-id $movemouse
bindsym $mod+Shift+Tab    focus parent, focus prev, focus child; exec --no-startup-id $movemouse
bindsym $mod+Caps_Lock    focus parent, focus prev, focus child; exec --no-startup-id $movemouse

bindsym $mod+Control+Tab focus parent, focus prev, focus child, focus prev, focus parent, focus parent, focus child, mark --add "swapee", focus prev, swap container with mark "swapee", unmark "swapee"; exec --no-startup-id $movemouse
bindsym $mod+Control+Shift+Tab mark --add "swapee", focus prev, focus parent, focus prev, focus child, focus parent, focus prev, focus child, focus parent, focus prev, focus child, focus parent, focus prev, focus child, swap container with mark "swapee", unmark "swapee"; exec --no-startup-id $movemouse

bindsym $mod+bar          workspace next
bindsym $mod+ordmasculine workspace next
bindsym $mod+Escape       workspace next

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle; exec --no-startup-id $movemouse

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle; exec --no-startup-id $movemouse

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws0 "0"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws0

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1, workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2, workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3, workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4, workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5, workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6, workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7, workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8, workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9, workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws0, workspace number $ws0

workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output secondary
workspace $ws5 output primary
workspace $ws6 output primary
workspace $ws7 output primary
workspace $ws8 output primary
workspace $ws9 output primary
workspace $ws0 output secondary

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

#xrdb ~/.Xresources
#xrdb ~/.Xdefaults
set_from_resource $color-black-normal   i3wm.color0  #000000
set_from_resource $color-black-bright   i3wm.color8  #000000
set_from_resource $color-red-normal     i3wm.color1  #FF0000
set_from_resource $color-red-bright     i3wm.color9  #FF0000
set_from_resource $color-yellow-normal  i3wm.color2  #FFFF00
set_from_resource $color-yellow-bright  i3wm.color10 #FFFF00
set_from_resource $color-green-normal   i3wm.color3  #00FF00
set_from_resource $color-green-bright   i3wm.color11 #00FF00
set_from_resource $color-blue-normal    i3wm.color4  #0000FF
set_from_resource $color-blue-bright    i3wm.color12 #0000FF
set_from_resource $color-magenta-normal i3wm.color5  #FF00FF
set_from_resource $color-magenta-bright i3wm.color13 #FF00FF
set_from_resource $color-cyan-normal    i3wm.color6  #00FFFF
set_from_resource $color-cyan-bright    i3wm.color14 #00FFFF
set_from_resource $color-white-normal   i3wm.color7  #FFFFFF
set_from_resource $color-white-bright   i3wm.color15 #FFFFFF

set $frame-color       #BBBBBB
set $inactive-bg-color #666666

# window colors
#                       border              background         text                 indicator
client.focused          $frame-color        $frame-color       $frame-color         $frame-color
client.unfocused        $frame-color        $inactive-bg-color $frame-color         $frame-color
client.focused-inactive $frame-color        $inactive-bg-color $frame-color         $frame-color
client.urgent           $frame-color        $frame-color       $frame-color         $frame-color


# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
	# mode invisible
	mode hide
	position bottom
	status_command i3status
}

gaps inner 0px
gaps outer 0px
smart_gaps inverse_outer

default_border none
default_floating_border none

hide_edge_borders smart_no_gaps

workspace $ws1 gaps vertical 90px
workspace $ws1 gaps horizontal 6px

workspace $ws3 gaps vertical 0px
workspace $ws3 gaps right 957px
workspace $ws3 gaps inner 6px
workspace $ws3 gaps left 0px

workspace $ws4 gaps vertical 0px
workspace $ws4 gaps right 957px
workspace $ws4 gaps inner 6px
workspace $ws4 gaps left 0px

exec --no-startup-id picom --vsync --backend glx --unredir-if-possible --blur-method kawase --blur-strength 5 --corner-radius 16 --rounded-corners-exclude "!I3_FLOATING_WINDOW@:c" -c -r 4 -l -4 -t -4 --shadow-color "#FFFFFF" --shadow-exclude "window_type *= 'menu' || window_type = 'tooltip' || window_type = 'combo' || window_type = 'dnd' || window_type = 'notification' || role = 'Popup'" --blur-background-exclude "!(class_g = 'kitty' || class_g = 'Gnome-terminal')"

exec_always --no-startup-id feh --bg-fill ~/wallpaper.jpg

exec_always --no-startup-id xset s off -dpms # disables Display Power Management Signaling

exec_always --no-startup-id setxkbmap es

exec_always --no-startup-id $virtmgr

for_window [class="eog"] floating enable
for_window [class="Eog"] floating enable
for_window [class="OSD"] move to workspace $ws4
for_window [class="java"] move to workspace $ws2
for_window [class="Java"] move to workspace $ws2
for_window [class="Eclipse"] move to workspace $ws2
for_window [class="virt-manager"] move to workspace $ws5
for_window [class="Virt-manager"] move to workspace $ws5
for_window [class="virt-manager" floating] border pixel 2
for_window [class="Virt-manager" floating] border pixel 2
for_window [class="Gnome-terminal"] floating enable
for_window [class="gnome-calculator"] floating enable

focus_wrapping force
